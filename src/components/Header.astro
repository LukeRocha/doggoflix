---
import logo from '../assets/logo.png';
import profileImg from '../assets/cassogo-profile.jpg';
import { Icon } from 'astro-icon/components';
---

<header id="header-wrapper" class="fixed top-0 left-0 z-[150] flex h-16 w-full items-center justify-center transition-all duration-500">
  <div id="header-bg" class="absolute inset-0 bg-[#00050d] transition-all duration-500 ease-in-out"></div>

  <div id="overlay" class="z-85 blur-sm"></div>

  <div class="relative z-90 flex h-full w-full items-center justify-between px-6 md:px-12">
    <div class="flex items-center">
      <button
        class="relative flex cursor-pointer items-center rounded p-2 px-2 text-lg font-medium tracking-wide text-white transition-colors hover:bg-white hover:text-black md:hidden"
        id="header-button"
      >
        Menu
        <Icon name="material-symbols:arrow-drop-down-rounded" class="text-xl" id="chevron-menu" />
      </button>

      <div class="hidden items-center md:flex">
        <nav class="flex items-center justify-start gap-5">
          <span>
            <a href="/" aria-label="DOGGO Home">
              <img src={logo.src} alt="DOGGO" class="w-[80px] cursor-pointer" />
            </a>
          </span>
          <ul class="flex justify-start gap-[8px]">
            <li class="w-full">
              <a
                href="/"
                class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
              >
                Movies
              </a>
            </li>
            <li class="w-full">
              <a
                href="/"
                class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
              >
                Shows
              </a>
            </li>
            <li class="w-full">
              <a
                href="/"
                class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
              >
                Sports
              </a>
            </li>
            <li class="w-full">
              <a
                href="/"
                class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
              >
                Live
              </a>
            </li>
            <li class="w-full">
              <a
                href="/"
                class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
              >
                Music
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <ul id="header-menu" class="absolute top-[54px] left-5 w-[180px] flex-col gap-1 rounded-lg bg-[#1a1a1a] p-2 shadow-2xl ring-1 ring-white/10">
      <li class="w-full">
        <a href="/" class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
          >Home</a
        >
      </li>
      <li class="w-full">
        <a href="/" class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
          >Shows</a
        >
      </li>
      <li class="w-full">
        <a href="/" class="text-md block w-full rounded-md px-4 py-2.5 font-medium tracking-wide text-white transition-all hover:bg-white/10 hover:text-white"
          >Movies</a
        >
      </li>
      <li class="mt-2 w-full px-1 pb-2">
        <button
          type="button"
          class="relative flex w-full cursor-pointer items-center justify-center rounded-md bg-[#00a8e1] px-4 py-2.5 text-sm font-bold tracking-wider text-white shadow-[0_0_15px_rgba(0,168,225,0.5)] transition-all duration-300 hover:scale-[1.02] hover:bg-[#00c3ff] hover:shadow-[0_0_25px_rgba(0,168,225,0.7)] active:scale-95"
        >
          Join Doggo
        </button>
      </li>
    </ul>

    <a href="/" aria-label="DOGGO Home" class="md:hidden">
      <img src={logo.src} alt="DOGGO" class="w-[80px] cursor-pointer" />
    </a>

    <div class="relative flex flex-row items-center gap-4">
      <div class="flex items-center gap-3">
        <Icon name="material-symbols:search-rounded" width="28" height="28" class="hidden cursor-pointer text-white transition-colors md:flex" />
        <Icon name="material-symbols:notifications-outline-sharp" width="28" height="28" class="shake-hover cursor-pointer text-white" />
        <img src={profileImg.src} alt="Profile" class="h-8 w-8 cursor-pointer rounded-full object-cover" />
      </div>
    </div>
  </div>
</header>

<script type="module">
  const menuButton = document.getElementById('header-button');
  const headerNav = document.getElementById('header-menu');
  const appOverlay = document.getElementById('overlay');
  const chevronMenu = document.getElementById('chevron-menu');

  menuButton.addEventListener('click', () => {
    if (headerNav.style.display === 'none' || !headerNav.style.display) {
      headerNav.style.display = 'flex';
      appOverlay.style.display = 'block';
      menuButton.style.backgroundColor = 'white';
      menuButton.style.color = 'black';
      chevronMenu.style.transform = 'rotate(180deg)';
    } else {
      headerNav.style.display = 'none';
      appOverlay.style.display = 'none';
      menuButton.style.backgroundColor = 'black';
      menuButton.style.color = 'white';
      chevronMenu.style.transform = 'rotate(0deg)';
    }
  });

  const wrapper = document.getElementById('header-wrapper');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20 && window.innerWidth > 768) {
      wrapper.classList.add('scrolled');
    } else {
      wrapper.classList.remove('scrolled');
    }
  });

</script>

<style>
  #header-bg {
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    left: 49.99999%;
    transform: translateX(-50%);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);

    background-color: #00050d;
    border-bottom: 1px solid transparent;
  }

  #header-wrapper.scrolled #header-bg {
    background-color: rgba(0, 5, 13, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    width: 96%;
  }

  header nav a,
  header button,
  header img {
    transition: none !important;
  }

  #overlay {
    display: none;
    position: absolute;
    height: 100vh;
    width: 100vw;
    top: 0;
    left: 0;
    background-color: black;
    opacity: 0.6;
    z-index: 85;
  }

  #header-menu {
    display: none;
    z-index: 100;
  }

  @keyframes smooth-shake {
    0%,
    100% {
      transform: translateX(0) rotate(0deg);
    }
    25% {
      transform: translateX(-1.5px) rotate(-1deg);
    }
    75% {
      transform: translateX(1.5px) rotate(1deg);
    }
  }

  .shake-hover:hover {
    animation: smooth-shake 0.4s ease-in-out infinite;
    display: inline-block;
  }
</style>
