---
import { Icon } from 'astro-icon/components';

interface Movie {
  id: string;
  title: string;
  img: ImageMetadata;
  alt: string;
  href?: string;
  rating?: number;
}
const { title, img, rating, alt } = Astro.props as Movie;
---

<div class="movie-card flex w-[160px] flex-none shrink-0 flex-col gap-3 px-2 text-white group">
  
  <div class="relative group z-0 hover:z-50 w-full h-[240px] duration-150 hover:scale-110">
    <img
      src={img.src}
      alt=""
      class="relative z-20 stretch mt-8 block h-full w-full max-w-none cursor-pointer rounded bg-position-[center_top_1rem] object-cover duration-100"
    />

    <div 
      class="side-menu hidden absolute top-8 left-[90%] z-10 h-full items-end w-[160px] flex-col gap-3 bg-zinc-900 p-4 shadow-2xl rounded-r-md group-hover:flex"
    >
<div  class="flex items-center gap-1.5">
       <Icon name="material-symbols:star-rate-rounded" class="text-yellow-500 w-4 h-4" />
       <span class="text-xs font-semibold text-gray-400">
         {rating?.toFixed?.(1) ?? rating}
       </span>
    </div>
      <h1 class="mt-auto text-lg font-bold text-white text-right">{title}</h1>
      <span class="flex gap-2">
         <Icon name="material-symbols:play-circle-rounded" class="w-8 h-8 text-white hover:text-blue-400 cursor-pointer" />
         <Icon name="material-symbols:add-box-outline" class="w-8 h-8 text-white hover:text-gray-300 cursor-pointer"/>
      </span>
      <div class=" text-[10px] text-gray-500">
        <p>1h 45m • Ação</p>
        <p class="line-clamp-2 mt-1">Sinopse curta...</p>
      </div>
      <span class="flex items-center gap-2 text-gray-300">
         <Icon name="material-symbols:shopping-bag-speed-outline" class=" text-yellow-500 w-4 h-4"/>
         <small class="text-[10px] text-yellow-500">Buy, rent or steal it.</small>
        </span>
    </div>
  </div>

  <div id="movie-title" class="flex mt-2 gap-1 transition-opacity z-30">
    <h2 class="w-full truncate text-base font-medium tracking-wide text-gray-100 drop-shadow-md">
      {title}
    </h2>
    <div  class="flex items-center gap-1.5">
       <Icon name="material-symbols:star-rate-rounded" class="text-yellow-500 w-4 h-4" />
       <span class="text-xs font-semibold text-gray-400">
         {rating?.toFixed?.(1) ?? rating}
       </span>
    </div>
  </div>

</div>

<script>
  const cards = document.querySelectorAll('.movie-card');

  cards.forEach((card) => {
    const menu = card.querySelector('.side-menu');

    card.addEventListener('mouseenter', () => {
      if (!menu) return;
      const elementPosition = card.getBoundingClientRect();
      const menuWidth = 180;
      const spaceRight = window.innerWidth - elementPosition.right;
      const menuMovieRank = document.getElementById('movie-title')
      if (spaceRight < (menuWidth - 20)) {
        menu.classList.add('open-left');
        if(menuMovieRank){
          menuMovieRank.classList.add('hidden')
        }
      } else {
        menu.classList.remove('open-left');
        if(menuMovieRank){
          menuMovieRank.classList.remove('hidden')
        }
      }
    });
  });
</script>

<style>
  .open-left {
    left: auto !important;
    right: 90% !important;
    align-items: start;
    text-align: left;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-top-left-radius: 0.375rem;
    border-bottom-left-radius: 0.375rem;
  }
  .open-left h1{
    left: 0
  }

</style>